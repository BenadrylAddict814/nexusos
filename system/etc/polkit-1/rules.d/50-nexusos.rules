// NexusOS: the person signed in at this computer can join Wi-Fi networks without typing a password.
// Everything else (updates, time zone, installing) still asks for it.
polkit.addRule(function (action, subject) {
  if (subject.local && subject.active && subject.isInGroup("netdev") &&
      action.id.indexOf("org.freedesktop.NetworkManager.") === 0) {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});

// NexusOS 1.5: "Restart into Windows" needs no password, just like a normal restart.
polkit.addRule(function (action, subject) {
  if (action.id === "org.freedesktop.policykit.exec" && subject.local && subject.active &&
      action.lookup("program") === "/usr/lib/nexusos/nexus-system" &&
      action.lookup("command_line") === "/usr/lib/nexusos/nexus-system reboot-windows") {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
