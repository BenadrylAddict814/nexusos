#!/usr/bin/python3
# NexusOS: watches the Caps Lock and Num Lock lights and prints a line when one changes,
# so the desktop can show "Caps Lock on/off". Uses only libX11 (no extra packages).
import ctypes, ctypes.util, json, sys, time
x = ctypes.cdll.LoadLibrary(ctypes.util.find_library('X11') or 'libX11.so.6')
x.XOpenDisplay.restype = ctypes.c_void_p; x.XOpenDisplay.argtypes = [ctypes.c_char_p]
x.XInternAtom.restype = ctypes.c_ulong; x.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
x.XkbGetNamedIndicator.restype = ctypes.c_int
x.XkbGetNamedIndicator.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int), ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
d = x.XOpenDisplay(None)
if not d:
    print(json.dumps({'type': 'fatal', 'error': 'no display'}), flush=True); sys.exit(2)
names = {'caps': x.XInternAtom(d, b'Caps Lock', 0), 'num': x.XInternAtom(d, b'Num Lock', 0)}
def state():
    out = {}
    for k, atom in names.items():
        on = ctypes.c_int(0)
        out[k] = bool(on.value) if x.XkbGetNamedIndicator(d, atom, None, ctypes.byref(on), None, None) else None
    return out
last = state()
print(json.dumps({'type': 'ready', **last}), flush=True)
while True:
    time.sleep(0.15)
    now = state()
    for k in names:
        if now[k] is not None and now[k] != last[k]:
            print(json.dumps({'type': 'change', 'key': k, 'on': now[k]}), flush=True)
    last = now
    if sys.stdout.closed: break
